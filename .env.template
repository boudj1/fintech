# ============================================================
# Enterprise AI Platform - Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# JWT Secret (change in production - must be at least 32 chars)
JWT_SECRET=EnterpriseSecureJWTSecret256BitsLong!ForProductionChange!

# OpenAI API Key (required for AI chatbot full functionality)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Grafana admin password
GRAFANA_PASSWORD=admin

# Email settings (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
